# Copy to .env and fill in your provider's settings.
# Use an API base URL, not the complete /chat/completions endpoint.
LLM_API_KEY=
LLM_MODEL=YOUR-MODEL-ID
LLM_BASE_URL=https://YOUR-PROVIDER/v1

# Optional: parent directory for saved runs (default: ~/.goalforge).
# GOALFORGE_HOME=/path/to/goalforge-state
